	//	ceiling += (snoise((pos.xz + seedOffsetCeiling + chunkOffset.xz) * noiseFreqCeiling) + 1) * amp * ceilingVariance;
	//	noiseFreqCeiling *= lacunarity;
	//	amp *= persistence;
	//}
	//
	////ceiling = (snoise((pos.xz + seedOffsetCeiling + chunkOffset.xz) * noiseFreq2) + 1) * 0.5 * ceilingVariance + ceiling + groundLevel;
	////ceiling = (1 - abs(snoise((pos.xz + seedOffsetCeiling + chunkOffset.xz) * noiseFreq2 * 0.5))) * ceilingVariance + ceiling + groundLevel;
	//
	//if (pos.y + chunkOffset.y <= groundLevel + groundBlend)
	//{
	//	float difference = groundLevel + groundBlend - chunkOffset.y - pos.y + 2;
	//	val = val - (difference / groundBlend) * (difference / groundBlend) * (difference / groundBlend);
	//	if (val > 1)
	//		val = 1;
	//}
	//else if (pos.y + chunkOffset.y >= ceiling - ceilingBlend)
	//{
	//	if (isCavernous)
	//	{
	//		float difference = pos.y + 2 - ceiling + ceilingBlend;
	//		val = val - (difference / ceilingBlend) * (difference / ceilingBlend) * (difference / ceilingBlend);
	//		if (val > 1)
	//			val = 1;
	//	}
	//	else
	//	{
	//		float difference = pos.y + chunkOffset.y - ceiling + ceilingBlend + 2;
	//		val = val + (difference / ceilingBlend) * (difference / ceilingBlend) * (difference / ceilingBlend);
	//		if (val < -1)
	//			val = -1;
	//	}
	//}
	
	int yPos = pos.y + chunkOffset.y;
	
	//groundLevel += -150;
	//ceiling += -150;
	
	
	
	
	
	
	
	
	
	
	//float squash = ((yPos - groundLevel) / (ceiling - groundLevel));
	//
	//if (yPos > groundLevel + (ceiling - groundLevel) * 0.5)
	//{
	//	val = lerp(val, -1, smoothstep((yPos - (groundLevel + (ceiling - groundLevel) * 0.5)) / ((ceiling - groundLevel) * 0.5)));
	//}
	//if (yPos < groundLevel + (ceiling - groundLevel) * 0.5)
	//{
	//	val = lerp(-1, val, smoothstep((yPos - groundLevel) / ((ceiling - groundLevel) * 0.5)));
	//}
	//
	//
	//if (yPos > ceiling)
	//{
	//	val = -1;
	//}
	//if (yPos < groundLevel)
	//{
	//	val = -1;
	//}
	//
	//if (yPos < 70)
	//{
	//	//val = -1;
	//}
    float val2 = 0;
    float val3 = 0;
    float ampB = 0.5;
    float freqB = 0.0005;
	
    for (int k = 0; k < octaves; ++k)
    {
        val2 += snoise((worldPos + seedOffset + float3(434342, 652432, -21333)) * freqB) * ampB;
        val3 += snoise((worldPos + seedOffset + float3(783456, 234235, -65432)) * freqB) * ampB;
        freqB *= lacunarity;
        ampB *= persistence;
    }
	
    val = value; //-------------------------
	
    uint numRooms;
    uint strideRooms;
    rooms.GetDimensions(numRooms, strideRooms);
	
    bool isCloseToARoom = false;
	
    float roomValues[64];
    uint validRoomIndices[64];
    uint numValidRooms = 0;
	
    //worldPos = worldPos + float3(val, -val, 0.5* val);
	
	
    for (uint n = 0; n < numRooms; n++)
    {
        float tempVal = val;
		
		
        //uint connectedIDs[4] = { rooms[n].connectedID1, rooms[n].connectedID2, rooms[n].connectedID3, rooms[n].connectedID4 };
		
        if (abs(length(rooms[n].position.xyz - worldPos.xyz)) < rooms[n].radius + rooms[n].radiusBlend * 2 + rooms[n].radiusOuter + 10
 || (
			abs(length(rooms[n].position.xz - worldPos.xz)) < rooms[n].radius + rooms[n].radiusBlend * 2 + rooms[n].radiusOuter
			&& worldPos.y - rooms[n].position.y > 0
			&& worldPos.y - rooms[n].position.y < rooms[n].height + rooms[n].heightBlend
			))
        {
            float distToRoomCenter = length(rooms[n].position.xz - worldPos.xz) - (snoise(worldPos * 0.01) * rooms[n].radiusBlend * 0.5 - 0.5);
            float roomGround = rooms[n].position.y + (val + 1) * 0.5 * 4;
            float roomCeiling = roomGround + rooms[n].height + (val2 - 1) * 0.5 * 4;
			
			
            if (distToRoomCenter < rooms[n].radius) // Inner Radius
            {
                tempVal = 1;//lerp(1, tempVal, (yPos - rooms[n].position.y) / (rooms[n].radius + rooms[n].radiusBlend * 2 + rooms[n].radiusOuter));
				
				
				
                roomCeiling = (roomGround + rooms[n].heightBlend + rooms[n].height);
				
            }
            else if (distToRoomCenter < rooms[n].radius + rooms[n].radiusBlend) // middle blend radius
            {
                tempVal = lerp(1, tempVal, smoothstep((distToRoomCenter - rooms[n].radius) / rooms[n].radiusBlend));
				
                roomCeiling = lerp(roomGround + rooms[n].heightBlend + rooms[n].height, roomGround + rooms[n].height, smoothstep((distToRoomCenter - rooms[n].radius) / rooms[n].radiusBlend));
                
            }
            else if (distToRoomCenter > rooms[n].radius + rooms[n].radiusBlend + rooms[n].radiusOuter) // outer blend radius
            {
                tempVal = lerp(tempVal, -1, smoothstep((distToRoomCenter - rooms[n].radius - rooms[n].radiusBlend - rooms[n].radiusOuter) / rooms[n].radiusBlend));
            }
			
			
			
			
            float roomMidPointY = (roomCeiling - roomGround) * 0.5;
			
            if (roomMidPointY > 10)
            {
                roomMidPointY = 10;
            }
				
				
			
			
            if (yPos > roomGround + roomMidPointY)
            {
                tempVal = lerp(tempVal, -1, smoothstep((yPos - (roomGround + roomMidPointY)) / ((roomCeiling - roomGround) - roomMidPointY)));
            }
            if (yPos < roomGround + roomMidPointY)
            {
                tempVal = lerp(-1, tempVal, smoothstep((yPos - roomGround) / (roomMidPointY)));
            }
	
            if (yPos > roomCeiling && abs(yPos - roomCeiling) < 10)
            {
                tempVal = -1;
            }
            else if (yPos < roomGround && abs(yPos - roomGround) < 10)
            {
                tempVal = -1;
            }
			
            isCloseToARoom = true;
			
            roomValues[n] = tempVal;
			
            validRoomIndices[numValidRooms] = n;
			
            numValidRooms += 1;
            
            //val = tempVal;
			
        }
		

		
		
    }
	
		
	
    if (!isCloseToARoom)
    {
        val = -1;
    }
    else
    {
        float minDist = 1.#INF;
        uint roomIndex = 0;
        float roomDist = 0;
		
        for (uint o = 0; o < numValidRooms; o++)
        {
            roomDist = length(rooms[validRoomIndices[o]].position - worldPos);
			
            if (roomDist < minDist)
            {
                minDist = roomDist;
                roomIndex = validRoomIndices[o];
            }
        }
		
        val = roomValues[roomIndex];
		
    }
	
	
    for (uint p = 0; p < numRooms; p++)
    {
        float tempVal2 = val;
		
		
        uint connectedIDs[4] = { rooms[p].connectedID1, rooms[p].connectedID2, rooms[p].connectedID3, rooms[p].connectedID4 };
		
        for (uint q = 0; q < 4; q++)
        {
            uint connectedID = connectedIDs[q];
			
            if (connectedID != (uint) 0)
            {
                float3 roomToRoomVector = normalize(rooms[connectedID - 1].position - rooms[p].position); // id must be its index plus 1
                float3 roomRadiusOffset1 = normalize(float3(roomToRoomVector.x, 0, roomToRoomVector.z)) * 0.85 * (rooms[p].radius + rooms[p].radiusBlend + rooms[p].radiusOuter) + float3(0, 15, 0);
                float3 roomRadiusOffset2 = normalize(float3(-roomToRoomVector.x, 0, -roomToRoomVector.z)) * 0.85 * (rooms[connectedID - 1].radius + rooms[connectedID - 1].radiusBlend + rooms[connectedID - 1].radiusOuter) + float3(0, 15, 0);
                //float3 roomToPosVector = normalize(worldPos - rooms[p].position);
                float3 closestPoint = ClosestPointLineSegment(worldPos, rooms[p].position + roomRadiusOffset1, rooms[connectedID - 1].position + roomRadiusOffset2);
				          
                float distToEntrace = distance(closestPoint, rooms[p].position + roomRadiusOffset1);
                if (distToEntrace > distance(closestPoint, rooms[connectedID - 1].position + roomRadiusOffset2))
                {
                    distToEntrace = distance(closestPoint, rooms[connectedID - 1].position + roomRadiusOffset2);
                }
				
                float3 tunnelNoiseOffset = float3(0, 0, 0);
				float amp = 1;
                float freq = 0.005;
	
				for (int j = 0; j < 8; ++j)
				{
                    tunnelNoiseOffset.x += (snoise((worldPos + seedOffset.xxx) * freq)) * amp;
                    tunnelNoiseOffset.y += (snoise((worldPos + seedOffset.yyy) * freq)) * amp;
                    tunnelNoiseOffset.z += (snoise((worldPos + seedOffset.zzz) * freq)) * amp;
                    freq *= 1.8715;
					amp *= 0.5;
				}
				
                tunnelNoiseOffset = ProjectVectorOnPlane(tunnelNoiseOffset * float3(45, 15, 45), roomToRoomVector); //chaoticness
				
                if (distToEntrace < 30)
                {
                    tunnelNoiseOffset = float3(
					lerp(0.2 * tunnelNoiseOffset.x, tunnelNoiseOffset.x, smoothstep(distToEntrace / 30.0)),
					lerp(0.2 * tunnelNoiseOffset.y, tunnelNoiseOffset.y, smoothstep(distToEntrace / 30.0)), 
					lerp(0.2 * tunnelNoiseOffset.z, tunnelNoiseOffset.z, smoothstep(distToEntrace / 30.0))
					);
					
                    //tempVal2 = lerp(tempVal2, tempVal);
					

                }
				
                closestPoint = closestPoint + tunnelNoiseOffset;
				
                float distToTunnelCenter = distance((closestPoint) * (float3(1, 2, 1)), worldPos * (float3(1, 2, 1)));
				
                //distToTunnelCenter += snoise(worldPos * 0.02) * 10;
				
				
				
                if (distToTunnelCenter < 5)
                {
                    tempVal2 = 1;
					
                    val = tempVal2;
                }
                else if (distToTunnelCenter < 35)
                {
                    tempVal2 = lerp(1, tempVal2, (distToTunnelCenter - 5) / 30);

                    val = tempVal2;
                }
            }
        }
    }
	
	
	
	
    int3 layerThickness = int3(48, 128, 172);
	
	float heightDifference = yPos - groundLevel;
	
	if (heightDifference > 0)
	{
		terrainType = 0.999;
	}
	else if (heightDifference > -layerThickness.r)
	{
		
		if (heightDifference > -layerThickness.r + (layerThickness.r * 0.8))//heightDifference / -layerThickness > 0.95)
		{
			terrainType = lerp(0.998, 0.999, 1 - (heightDifference / -layerThickness.r) * 5);
		}
		else
		{
			terrainType = 0.998;
		}
	}
	else if (heightDifference > -layerThickness.g)
	{
		if (heightDifference > -layerThickness.g + ((layerThickness.g - layerThickness.r) * 0.8))//heightDifference / -layerThickness > 0.95)
		{
			terrainType = lerp(0.997, 0.998, 1 - ((heightDifference + layerThickness.r) / (-layerThickness.g + layerThickness.r)) * 5);
		}
		else
		{
			terrainType = 0.997;
		}
	}
	else if (heightDifference > -layerThickness.b)
	{
		terrainType = 0.996;
	}
	else
	{
		terrainType = 0.996;
	}
	
	
	
	
	
	
	
	float preDeformedValue = val;
	
	
	uint numDeformations;
	uint strideDeformations;
	deformations.GetDimensions(numDeformations, strideDeformations);
	
	for (uint i = 0; i < numDeformations; i++)
	{
		if (i != 0)
		{
			float3 deformationPos = deformations[i].position;
		
		
			float radius = deformations[i].radius;
			
			radius *= (terrainType - 0.995) * 200;
			
			
			
			float radiusNoise = 0;
			float amp = deformations[i].noiseAmp;
			float radiusFreq = deformations[i].noiseFreq;
			float radiusLac = deformations[i].noiseLac;
			float radiusPers = deformations[i].noisePers;
			
			for (int j = 0; j < deformations[i].noiseOct; ++j)
			{
				radiusNoise += (snoise((worldPos + deformationPos * 111.9715) * radiusFreq) + 1) * 0.5 * radius * amp;
				radiusFreq *= radiusLac;
				amp *= radiusPers;
			}
			
			radius -= radiusNoise ;
			
			
			float radiusBlend = deformations[i].blend;
			radiusBlend *= 1.5 - (terrainType * 0.5);
		
			float dist = length(deformationPos - worldPos);
			
		
			if (dist < radius)
			{
				if (dist < radius * (1 - radiusBlend))
				{
					val = isoLevel + 0.02;
				}
				else
				{
					float weight = 1.0 - ((dist - radius * (1 - radiusBlend)) / (radius * radiusBlend));
				
					clamp(weight, 0.0, 1.0);
				
					val = lerp(val, isoLevel + 0.02, weight);
				}
			}
		}
	}
	
	
	
	
	//float valueDifference = (preDeformedValue - val + 1);
	//
	//if (heightDifference > 0)
	//{
	//	if (valueDifference > 0.95)
	//	{
	//		terrainType = clamp(lerp(0.999, 1.0, (valueDifference - 0.95) * 20), 0.999, 1);
	//	}
	//}
	
	//if (preDeformedValue < isoLevel - 0.1)
	//{
	//    terrainType = 0.9;
	//}
	//else
	//{
	//    terrainType = lerp(1, 0.9, (isoLevel - preDeformedValue) * 10);
	//}
	// 
	//if (preDeformedValue < isoLevel - 0.7)
	//{
	//    terrainType = 0.7;
	//}
	//else if (preDeformedValue < isoLevel - 0.6)
	//{
	//    terrainType = lerp(0.9, 0.7, ((isoLevel - 0.6) - preDeformedValue) * 10);
	//}
	
	
	float oreValue = (snoise((pos.xyz + seedOffset + chunkOffset.xyz) * 0.03) + 1) * 0.5;
	float oreMask = (snoise((pos.xyz + float3(seedOffsetCont.x, seedOffsetCeiling.y, seedOffsetErosion.y) + chunkOffset.xyz) * 0.03) + 1) * 0.5;
	
	float originalType = terrainType;
	
	
	if (true)//terrainType < 0.9995 || terrainType > 1.0)
	{
		if (oreValue > 0.8)
		{
			//terrainType += 1;
		}
		else if (oreMask < 0.2)
		{
			//terrainType += 2;
		}
	}
	
	
	//if (currentIsland.gridID.x == 0 && currentIsland.gridID.y == 0)
	//{
	//    terrainType = 2;
	//}
	
	//terrainType += 1;
	
	//if (oreValue > 0.9)
	//{
	//    terrainType += 1;
	//}
	//else if (oreMask < 0.1)
	//{
	//    terrainType += 2;
	//}
	
	
	
	//terrainType = originalType + 1.0;
	
	
	
	uint empty = 0;
	
	if (pos.x == chunkSize - 1)
	{
		if (val <= isoLevel)
		{
			InterlockedCompareExchange(sides[0], 0, 1, empty);
		}
		else
		{
			InterlockedCompareExchange(sides[6], 0, 1, empty);
		}
		
	}
	else if (pos.x == 0)
	{
		if (val <= isoLevel)
		{
			InterlockedCompareExchange(sides[1], 0, 1, empty);
		}
		else
		{
			InterlockedCompareExchange(sides[7], 0, 1, empty);
		}
	}
	if (pos.y == chunkSize - 1)
	{
		if (val <= isoLevel)
		{
			InterlockedCompareExchange(sides[2], 0, 1, empty);
		}
		else
		{
			InterlockedCompareExchange(sides[8], 0, 1, empty);
		}
	}
	else if (pos.y == 0)
	{
		if (val <= isoLevel)
		{
			InterlockedCompareExchange(sides[3], 0, 1, empty);
		}
		else
		{
			InterlockedCompareExchange(sides[9], 0, 1, empty);
		}
	}
	if (pos.z == chunkSize - 1)
	{
		if (val <= isoLevel)
		{
			InterlockedCompareExchange(sides[4], 0, 1, empty);
		}
		else
		{
			InterlockedCompareExchange(sides[10], 0, 1, empty);
		}
	}
	else if (pos.z == 0)
	{
		if (val <= isoLevel)
		{
			InterlockedCompareExchange(sides[5], 0, 1, empty);
		}
		else
		{
			InterlockedCompareExchange(sides[11], 0, 1, empty);
		}
	}
	
	PointData pd;
	pd.density = val;
	pd.terrainType = terrainType;
	
	return pd;
}

[numthreads(8,8,8)]
void NoiseGen (uint3 id : SV_DispatchThreadID)
{
	float value = 0;
	
	
	
	for (int i = 0; i < octaves; ++i)
	{
		value += snoise((float3(id.x, id.y, id.z) + chunkOffset + seedOffset) * noiseFreq) * amplitude;
		noiseFreq *= lacunarity;
		amplitude *= persistence;
	}
	
	
	
	points[indexFromCoord(id.x, id.y, id.z)] = heightBlend(float3(id.x, id.y, id.z), value);
	
}
