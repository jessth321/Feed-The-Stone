float evaluationLength;

int chunkSize;
float3 chunkOffset;
float isoLevel;

float3 seedOffset;
float2 seedOffsetGround;
float2 seedOffsetCeiling;
float2 seedOffsetCont;
float2 seedOffsetErosion;
float2 seedOffsetCliffs;

float noiseFreq;
float noiseFreqGround;
float noiseFreqCeiling;
float noiseFreqMask;

int octaves;//= 4;
float lacunarity;//= 1.8715;
float persistence;//= 0.65;
float amplitude;//= 1.0;

float groundLevel;
float groundBlend;
float groundVariance;

float ceiling;
float ceilingBlend;
float ceilingVariance;

float noiseMask;

bool isCavernous;
float terrainType;


int indexFromCoord(int x, int y, int z)
{
	return x + y * chunkSize + z * chunkSize * chunkSize;
}

int indexFromCoord(int x, int y)
{
	return x + y * chunkSize;
}

float lerp(float a, float b, float t)
{
	return a + t * (b - a);
}

float smoothstep(float x)
{
	x = clamp((x), 0.0f, 1.0f);
	return x * x * (3 - 2 * x);
}

float3 projectOnPlane(float3 vec, float3 normal)
{
	return vec - normal * dot(vec, normal);
}
float angleBetween(float2 a, float2 b)
{
	// Calculate the dot product
	float dotProduct = dot(a, b);
	// Use arccos to find the angle in radians
	return acos(dotProduct);
}


