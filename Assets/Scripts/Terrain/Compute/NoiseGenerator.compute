int indexFromCoord(int x, int y, int z)
{
	return x + y * chunkSize + z * chunkSize * chunkSize;
}

int indexFromCoord(int x, int y)
{
	return x + y * chunkSize;
}

float lerp(float a, float b, float t)
{
	return a + t * (b - a);
}

float smoothstep(float x)
{
	x = clamp((x), 0.0f, 1.0f);
	return x * x * (3 - 2 * x);
}

float3 projectOnPlane(float3 vec, float3 normal)
{
	return vec - normal * dot(vec, normal);
}
float angleBetween(float2 a, float2 b)
{
	// Calculate the dot product
	float dotProduct = dot(a, b);
	// Use arccos to find the angle in radians
	return acos(dotProduct);
}

float3 ClosestPointLineSegment(float3 inPoint, float3 segmentStart, float3 segmentEnd)
{
    float3 segment = segmentEnd - segmentStart;
    float3 toPoint = inPoint - segmentStart;
    
    float t = dot(toPoint, segment) / dot(segment, segment);
    t = clamp(t, 0.0, 1.0);
    
    return segmentStart + t * segment;
}

float3 ProjectVectorOnPlane(float3 inVector, float3 planeNormal)
{
    planeNormal = normalize(planeNormal);
    
    // Remove component parallel to normal (leaving only plane components)
    float parallelComponent = dot(inVector, planeNormal);
    return inVector - parallelComponent * planeNormal;
}


