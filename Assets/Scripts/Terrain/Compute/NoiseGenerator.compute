struct Deformation
{
	float3 position;
	float radius;
	float blend;
	float noiseFreq;
	float noiseOct;
	float noiseAmp;
	float noiseLac;
	float noisePers;
};

struct PointData
{
	float density;
	float terrainType;
};

struct IslandData
{
	int2 gridID;
	float2 peakLocation;
	int peakHeight;
};

struct RoomData // fewfa
{
    uint id;
    float3 position;
    float height;
	float heightBlend;
    float radius;
    float radiusOuter;
    float radiusBlend;
	uint connectedID1;
	uint connectedID2;
	uint connectedID3;
	uint connectedID4;
};

//int islandGridCellSize;

RWStructuredBuffer<PointData> points;
RWStructuredBuffer<uint> sides;
StructuredBuffer<float4> heightEvaluation; //
StructuredBuffer<Deformation> deformations;
StructuredBuffer<RoomData> rooms; // vdfsav
